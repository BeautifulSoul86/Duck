<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/keyline_5"
    android:paddingEnd="@dimen/keyline_5"
    tools:showIn="@layout/content_import_google_password_redesign">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/preImportIcon"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:layout_marginTop="@dimen/keyline_4"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/passwords_google_import_128" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/preImportTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        android:breakStrategy="balanced"
        android:gravity="center_horizontal"
        android:text="@string/importPasswordsChooseMethodDialogTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preImportIcon"
        app:typography="h1" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/preImportSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        android:gravity="center_horizontal"
        android:text="@string/importPasswordsChooseMethodDialogSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preImportTitle"
        app:typography="body1" />

    <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
        android:id="@+id/preImportButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        android:text="@string/importPasswordsChooseMethodDialogGpmButton"
        app:daxButtonSize="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preImportSubtitle"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
